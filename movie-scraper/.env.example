# CineSense server-side environment values — configure in Vercel Project Settings.
# NEVER commit actual values and never use NEXT_PUBLIC_ for private API keys.
TMDB_READ_ACCESS_TOKEN=
# Alternative (instead of TMDB_READ_ACCESS_TOKEN):
# TMDB_API_KEY=

# Required only if enabling YouTube trailer discovery and public trailer comments:
YOUTUBE_API_KEY=

# Owner-only guard for YouTube quota and DigiMoviez Chromium crawling.
# Generate a unique random value (at least 24 characters); do not reuse passwords.
CINESENSE_SCRAPER_ACCESS_CODE=

# Optional public model repository ID; the model weights are fetched by browsers:
PERSIAN_BROWSER_MODEL_ID=Aminvost/cinesense-persian-sentiment-onnx

# Optional source allowlist; default is digimoviez.com:
# DIGIMOVIEZ_ALLOWED_HOSTS=digimoviez.com

# Legacy Express scraper is a separate local prototype. The Next app no longer proxies requests to it.

# New shared MySQL 8+ source cache and optional registered accounts
DATABASE_URL=
# On the live site leave DATABASE_TLS_DISABLED unset; TLS is required.
SITE_URL=https://cinesense.aminvost.ir
# Private Resend API credential and verified sender for email verification/reset:
RESEND_API_KEY=
AUTH_EMAIL_FROM=
# For the Vercel Cron daily cleanup, create a separate random secret:
CRON_SECRET=
