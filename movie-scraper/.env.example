# Next.js API routes, no separate server required for TMDB on Vercel.
# Set in Vercel > Project > Settings > Environment Variables (never prefix with NEXT_PUBLIC_).
TMDB_READ_ACCESS_TOKEN=
# Alternative to read access token:
# TMDB_API_KEY=
# Optional, for YouTube trailer comments:
# YOUTUBE_API_KEY=
# Optional for local Express mode only. Do NOT configure it on Vercel.
# SCRAPER_API_URL=http://127.0.0.1:5000
